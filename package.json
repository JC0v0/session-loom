{
  "name": "session-loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirror Claude Code and Codex sessions into a durable canonical format and restore them into either tool.",
  "main": "electron/main.mjs",
  "bin": {
    "ssl": "./bin/ssl.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "desktop": "electron .",
    "dist": "electron-builder",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.sessionloom.app",
    "productName": "session-loom",
    "asar": false,
    "files": [
      "electron/**",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "session-loom"
    },
    "directories": {
      "output": "dist"
    }
  }
}

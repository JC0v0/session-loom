{
  "name": "session-loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirror Claude Code and Codex sessions into a durable canonical format and restore them into either tool.",
  "bin": {
    "ssl": "./bin/ssl.js"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "desktop": "tauri dev",
    "bundle:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-cli/cli.mjs --log-level=warning",
    "dist": "tauri build",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}

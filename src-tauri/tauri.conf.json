{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session-Loom",
  "version": "0.1.0",
  "identifier": "com.sessionloom.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run bundle:cli"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Session-Loom",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../dist-cli/cli.mjs": "dist-cli/cli.mjs"
    },
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}

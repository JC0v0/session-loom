{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session-Loom",
  "version": "0.2.0",
  "identifier": "com.sessionloom.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run dev:cli",
    "beforeBuildCommand": "npm run build:cli"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Session-Loom",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzRkI1QzkxNDhCRjRGOEYKUldTUFQ3OUlrVno3MDRkbUdRNURqMUt6WU42dDZkVGtHQnhYQVVvZ2FYeVN4clBqNU9WWFkrMGwK",
      "endpoints": [
        "https://github.com/JC0v0/session-loom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/": "bin/"
    },
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "nsis/install-hooks.nsh"
      }
    }
  }
}
